{
  "expo": {
    "name": "Saphir FM",
    "slug": "radio-saphir",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Icone2.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.radiosaphir.app",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Icone2.png",
        "backgroundColor": "#06040F"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.radiosaphir.app",
      "permissions": ["FOREGROUND_SERVICE", "WAKE_LOCK"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d1dced01-a7a1-49ee-9edc-80721ebb1bce"
      }
    },
    "owner": "marcel-app"
  }
}
