# Root Gitignore for Radio Saphir Monorepo

# Dependencies
**/node_modules/
**/.pnp
**/.pnp.js

# Next.js (web)
web/.next/
web/out/
web/next-env.d.ts

# Expo (mobile)
mobile/.expo/
mobile/dist/
mobile/web-build/
mobile/expo-env.d.ts
mobile/ios/
mobile/android/

# Production/Build
**/build/
**/dist/

# Env files (keep them local by default, but I'll check if user wants them)
.env*.local
.env
web/.env.local

# IDE
.vscode/
.idea/

# Misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
